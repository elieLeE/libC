# Makefile
# cible: dependances
# 	commandes
# $@ : cible
# $< : nom de la premiere dependance
# $^ : liste des dependances
# $? : liste des dependances plus recentes que la cible
# $* : nom du fichier sans le suffixe

CC := gcc
CFLAGS := -std=gnu2x -Wextra -Wall
LDFLAGS := -lm -lgmp
INCLUDE := -I. -I../src

BUILD_DIR := ./build
EXEC := test

# ------------------------------------------------------------------
# Sources :
# - test files in this folder (test_*.c)
# - source files in ../src/...
# ------------------------------------------------------------------
LIB_C_DIR := ../src

# Library sources files
LIB_SRC := $(wildcard \
	$(LIB_C_DIR)/containers/*.c \
	$(LIB_C_DIR)/mem/*.c \
	$(LIB_C_DIR)/logger/*.c \
	$(LIB_C_DIR)/io/*.c \
	$(LIB_C_DIR)/test_helper/*.c \
	$(LIB_C_DIR)/math/*.c \
	$(LIB_C_DIR)/tab_helper/*.c \
	$(LIB_C_DIR)/*.c)

# Test files
TEST_SRC := $(wildcard *.c)

SRC := $(LIB_SRC) $(TEST_SRC)

# Files sources become: toto.c -> build/test/toto.o
TEST_OBJ := $(patsubst %.c,$(BUILD_DIR)/test/%.o,$(TEST_SRC))

# Library ssources ../src/* become:
#   ../src/containers/utils.c -> build/containers/utils.o
#   ../src/utils.c            -> build/utils.o
LIB_OBJ := $(patsubst $(LIB_C_DIR)/%.c,$(BUILD_DIR)/%.o,$(LIB_SRC))

OBJ := $(TEST_OBJ) $(LIB_OBJ)

# Dependencies files generated by gcc:
# build/containers/utils.o -> build/containers/utils.d
DEP := $(OBJ:.o=.d)

# ------------------------------------------------------------------
# Rules
# ------------------------------------------------------------------

.PHONY: all debug cleanSimple clean

all: $(EXEC)

debug: CFLAGS += -DDDebug -g
debug: LDFLAGS += -DDDebug -g
debug: $(EXEC)

$(EXEC): $(OBJ)
	$(CC) -o $@ $^ $(LDFLAGS)

# build/containers/utils.o depends on ../src/containers/utils.c
# Le '%' keeps containers/utils, mem/mem, etc.
# $@ is the current target, @D is its directory
$(BUILD_DIR)/%.o: $(LIB_C_DIR)/%.c
	@mkdir -p $(@D)
	$(CC) $(INCLUDE) $(CFLAGS) -MMD -MP -c $< -o $@

# build/test/foo.o depends on ./foo.c
$(BUILD_DIR)/test/%.o: %.c
	@mkdir -p $(@D)
	$(CC) $(INCLUDE) $(CFLAGS) -MMD -MP -c $< -o $@

cleanSimple:
	rm -rf $(BUILD_DIR)

clean: cleanSimple
	rm -f $(EXEC)

# '-' means to not fail at first make when '.d' do not exist yet.
-include $(DEP)
