# Makefile
# cible: dependances
# 	commandes
# $@ : cible
# $< : nom de la premiere dependance
# $^ : liste des dependances
# $? : liste des dependances plus recentes que la cible
# $* : nom du fichier sans le suffixe

CC := gcc
CFLAGS := -std=gnu2x -Wextra -Wall
LDFLAGS := -lm -lgmp
INCLUDE := -I. -I../src

BUILD_DIR := ./build
EXEC := test

# ------------------------------------------------------------------
# Sources :
# - test files in this folder (test_*.c)
# - source files in ../src/...
# ------------------------------------------------------------------
LIB_C_DIR := ../src

SRC := $(wildcard *.c \
	$(LIB_C_DIR)/containers/*.c \
	$(LIB_C_DIR)/mem/mem.c \
	$(LIB_C_DIR)/logger/logger.c \
	$(LIB_C_DIR)/io/io.c \
	$(LIB_C_DIR)/test_helper/test_helper.c \
	$(LIB_C_DIR)/math/*.c \
	$(LIB_C_DIR)/tab_helper/tab_helper.c \
	$(LIB_C_DIR)/utils.c)

# We want that each file (whatever its path) becomes build/*.o
# 'notdir' keeps just the name of the file, 'patsubst' adds 'build'.
OBJ := $(patsubst %.c,$(BUILD_DIR)/%.o,$(notdir $(SRC)))

# dependencies files generated by gcc:
# build/containers/utils.o -> build/containers/utils.d
DEP := $(OBJ:.o=.d)

# ------------------------------------------------------------------
# Rules
# ------------------------------------------------------------------

.PHONY: all debug cleanSimple clean

all: $(EXEC)

debug: CFLAGS += -DDDebug -g
debug: LDFLAGS += -DDDebug -g
debug: $(EXEC)

$(EXEC): $(OBJ)
	@mkdir -p $(BUILD_DIR)
	$(CC) $(INCLUDE) -o $@ $^ $(LDFLAGS)

# VPATH : where make has to kook for the .c (this folder and sub-folders of 
# ../src)
VPATH := $(sort $(dir $(SRC)))

# generic rule: build/file.o from file.c found via VPATH
$(BUILD_DIR)/%.o: %.c
	@mkdir -p $(BUILD_DIR)
	# The options '-MMD -MP' lets generate '.d' dependencies files.
	# It will let detect that a '.h' has been modified and will recompiled
	# the files that include it.
	$(CC) $(INCLUDE) -MMD -MP -c $< -o $@ $(CFLAGS)

cleanSimple:
	rm -rf $(BUILD_DIR)

clean: cleanSimple
	rm -rf $(EXEC)

# '-' means to not fail at first make when '.d' do not exist yet.
-include $(DEP)
